{
    "name": "gmail-imap-tool",
    "version": "1.3.0",
    "private": true,
    "description": "Electron app: kich hoat IMAP (lay App Password ban tu dong) va doc inbox Gmail.",
    "author": "tama",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "test": "node --test",
        "dist": "electron-builder",
        "dist:portable": "electron-builder --win portable",
        "dist:installer": "electron-builder --win nsis"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "imapflow": "^1.0.164",
        "mailparser": "^3.7.1"
    },
    "devDependencies": {
        "@electron/packager": "^20.0.4",
        "electron": "^43.2.0",
        "electron-builder": "^25.1.8"
    },
    "build": {
        "appId": "com.tama.gmail-imap-tool",
        "productName": "Gmail IMAP Tool",
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "preload.js",
            "src/**/*",
            "renderer/**/*",
            "package.json"
        ],
        "win": {
            "signAndEditExecutable": false,
            "target": [
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "portable": {
            "artifactName": "GmailIMAPTool-portable-${version}.exe"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "shortcutName": "Gmail IMAP Tool",
            "artifactName": "GmailIMAPTool-Setup-${version}.exe"
        }
    }
}
