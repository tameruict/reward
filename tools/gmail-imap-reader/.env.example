# Copy file này thành ".env" rồi điền thông tin.
# App Password là mật khẩu ứng dụng 16 ký tự của Gmail (KHÔNG phải mật khẩu đăng nhập).
# Tạo tại: https://myaccount.google.com/apppasswords  (cần bật xác minh 2 bước trước)

GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Tuỳ chọn (mặc định đã đúng cho Gmail):
GMAIL_HOST=imap.gmail.com
GMAIL_PORT=993
