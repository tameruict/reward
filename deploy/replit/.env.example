# Add these values through Replit Secrets. Do not commit real values.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-long-random-password

# Alternative to a plaintext secret: 32-byte scrypt hash in hex plus its salt.
# DASHBOARD_PASSWORD_SALT=replace-with-random-salt
# DASHBOARD_PASSWORD_HASH=replace-with-64-hex-character-scrypt-hash

# Optional internal API port; it must differ from Replit's public PORT.
REPLIT_INTERNAL_API_PORT=3010
