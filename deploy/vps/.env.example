# VPS Control API
# With Tailscale, use the VPS address from `tailscale ip -4`.
API_HOST=100.x.y.z
API_PORT=3010
API_TOKEN=replace-with-a-long-random-api-token

# Required to encrypt passwords, recovery emails, TOTP secrets and proxy passwords.
# Generate once with: npm run accounts -- keygen
ACCOUNTS_DB_KEY=replace-with-a-generated-database-key
ACCOUNTS_SOURCE=database

# Optional runtime paths/settings
# ACCOUNTS_DB_PATH=/opt/reward/data/accounts.db
TZ=Asia/Ho_Chi_Minh
NODE_ENV=production

# Keep administrative writes disabled unless explicitly needed.
API_ALLOW_CONFIG_WRITE=false
API_ALLOW_CONFIG_REVEAL=false
API_ALLOW_SCHEDULE_WRITE=false
