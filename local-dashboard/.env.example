# VPS worker Control API. The browser never talks to this URL directly;
# the local dashboard keeps the token and proxies requests to the VPS.
CONTROL_API_URL=http://YOUR_VPS_HOST:3010
CONTROL_API_TOKEN=replace-with-the-same-long-token-as-vps-api

# Optional browser login; both values are required to enable it.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Dashboard settings (local machine)
PORT=8890
TZ=Asia/Ho_Chi_Minh
